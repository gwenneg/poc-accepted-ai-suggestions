# GitHub Personal Access Token for API authentication
# Required: yes
# Scopes needed: repo (for private repos) or public_repo (for public repos only)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Base URL for Claude API
# Required: yes
# Example for Vertex AI: https://us-central1-aiplatform.googleapis.com/v1/projects/YOUR_PROJECT/locations/us-central1/publishers/anthropic
MODEL_API=your_model_api_url_here

# Bearer token for Claude API authentication
# Required: yes
MODEL_USER_KEY=your_model_user_key_here
